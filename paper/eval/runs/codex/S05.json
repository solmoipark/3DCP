       "id": "item_4",
       "name": "sql_query",
       "input": {
        "sql": "SELECT COUNT(DISTINCT p.paper_uid) AS papers_with_vma_material, COUNT(DISTINCT CASE WHEN CAST(NULLIF(c.dosage_reported,'') AS REAL)>0 OR CAST(NULLIF(c.dosage_kg_m3,'') AS REAL)>0 OR CAST(NULLIF(c.mass_frac_of_binder,'') AS REAL)>0 THEN p.paper_uid END) AS papers_with_positive_vma_dosage FROM papers p JOIN materials m ON m.paper_uid=p.paper_uid LEFT JOIN mix_components c ON c.material_uid=m.material_uid AND c.paper_uid=p.paper_uid WHERE p.is_3dcp_study='1' AND m.material_class LIKE 'vma_%'"
