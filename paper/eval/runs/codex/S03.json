      {
       "id": "item_2",
       "name": "sql_query",
       "input": {
        "db": "print_process",
        "sql": "SELECT COALESCE(NULLIF(TRIM(failure_mode), ''), '(missing)') AS failure_mode, COUNT(*) AS print_run_count, (SELECT COUNT(*) FROM print_runs WHERE printability_label = 'non_printable') AS total_non_printable FROM print_runs WHERE printability_label = 'non_printable' GROUP BY COALESCE(NULLIF(TRIM(failure_mode), ''), '(missing)') ORDER BY print_run_count DESC"
